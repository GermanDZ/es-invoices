# FacturaSimple environment template (bootstrapped by T-011).
# Copy to .env and fill real values. .env is git-ignored; .env.example is tracked.
# NEVER commit real secrets or certificate material.

# --- Django core ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=

# --- Certificate at-rest encryption (T-011) ---
# Base64-encoded 32-byte key for AES-256-GCM, DISTINCT from DJANGO_SECRET_KEY.
# Generate one with:  python -c "from certificates.crypto import generate_key; print(generate_key())"
CERT_ENCRYPTION_KEY=

# --- PostgreSQL (AD-6, EU-resident per AD-4) ---
# When unset, the app falls back to a local SQLite db (dev/test only).
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
